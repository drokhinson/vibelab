# Cloudflare Pages response headers.
#
# sw.js, index.html and config.js must NOT be edge-cached: the service worker's
# entire update path depends on the browser re-fetching sw.js and finding a new
# BUILD_ID, and config.js is regenerated per deploy with the API origin in it.
# Everything under assets/ is content-hashed by scripts/bgb-bundle.mjs, so it is
# safe to pin for a year.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY

/sw.js
  Cache-Control: no-cache

/index.html
  Cache-Control: no-cache

/config.js
  Cache-Control: no-cache

/manifest.json
  Cache-Control: public, max-age=3600

/assets/*
  Cache-Control: public, max-age=31536000, immutable
