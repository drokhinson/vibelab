# Python
__pycache__/
*.py[cod]
*.pyo
.venv/
venv/
env/
*.egg-info/
dist/
build/
.pytest_cache/

# Environment
.env
.env.local
.env.*.local

# Local dev overrides — generated by local_dev/setup-local.py, never committed
local_dev/.env
projects/*/web/config.js
projects/*/app/.env

# Auth-migration inputs (projects/boardgame-buddy/tools/import-users-to-firebase.mjs).
# A backstop, not permission: *.users.json carries bcrypt password hashes and
# *.sa.json is a service-account key that can mint a token for any user in the
# project. Keep both outside the repo and delete them once the import is done.
*.users.json
*.sa.json

# Node / Expo
node_modules/
.expo/
dist/
build/
*.log
npm-debug.log*
package-lock.json
# Native apps need a committed lock file so EAS Build / expo-doctor can run.
!projects/*/app/package-lock.json
# Cloud Functions are deployed from source: the lockfile is what makes a
# later deploy install what the last one did.
!projects/*/functions/package-lock.json

# Web prototypes copy ../shared/ into web/shared/ at build time (see web/build.sh).
# The source of truth lives in projects/<name>/shared/.
projects/*/web/shared/

# Database
*.sqlite
*.sqlite3
*.db

# OS
.DS_Store
Thumbs.db

# IDE
.idea/
.vscode/
*.swp

# Claude Code
.claude/settings.local.json

# Vercel
.vercel/

# Railway
.railway/

# EAS / Play Store credentials — contains private keys that must not be committed.
play-service-account.json
*.keystore
*.jks
